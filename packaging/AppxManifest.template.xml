<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store. The $tokens$ are filled in by tools\package-msix.ps1;
     Identity and publisher values come from Partner Center > Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>LCapture</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809+, required by Windows.Media.Capture frame readers. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="$Language$" />
  </Resources>

  <Applications>
    <Application Id="LCapture" Executable="LCapture.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="LCapture"
        Description="Visualizador de placas de captura de vídeo (HDMI/USB), com baixa latência."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Desktop (WPF) app: runs outside the app container. Standard for packaged desktop apps. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Video and audio of the capture card; Windows asks the user on first use. -->
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
