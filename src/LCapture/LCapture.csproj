<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LCapture</AssemblyName>
    <RootNamespace>LCapture</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>1.1.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Only ship framework translations the UI can use; keeps the installer small. -->
    <SatelliteResourceLanguages>pt-BR;pt;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the WASAPI part (pulls NAudio.Core); the NAudio meta-package drags in WinForms. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Shaders\Sharpen.ps" />
  </ItemGroup>

</Project>
